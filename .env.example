# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Admin secret key — used for dashboard authentication and token signing
# Generate a strong random string: openssl rand -base64 32
ADMIN_SECRET_KEY="change-me-to-a-strong-random-secret"

# Public app URL (used for generating short link URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Smartlink URL — opened in a new tab on the first "Get Final Link" click (step 2)
# Replace with your Monetag/Adsterra/PropellerAds smartlink
NEXT_PUBLIC_SMARTLINK_URL="https://your-smartlink-url.com/click"
